{
  "name": "hostharbor",
  "version": "0.1.0",
  "description": "A secure desktop file manager for SFTP, FTP and explicit FTPS",
  "type": "module",
  "main": "app/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "test:integration": "node --test tests/protocols.integration.js",
    "package:mac": "node scripts/package.js",
    "test:ui": "node tests/ui.smoke.js"
  },
  "dependencies": {
    "basic-ftp": "6.2.5",
    "ssh2": "1.17.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "@electron/packager": "19.0.1",
    "ftp-srv": "4.6.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
